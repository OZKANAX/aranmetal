# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploads & db
/storage
/prisma/*.db
/prisma/*.db-journal
!.env.example

.vercel
.env*

